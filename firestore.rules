rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // A user can read only their own role doc.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Sign-up can only ever create a "client" role for yourself.
      allow create: if request.auth != null
                     && request.auth.uid == userId
                     && request.resource.data.role == "client";

      // Nobody can change their own role via the client SDK, ever.
      // Promoting to "rcic"/"admin" requires a direct Firebase Console
      // edit (which runs with admin privileges and bypasses these rules).
      allow update, delete: if false;
    }
  }
}
